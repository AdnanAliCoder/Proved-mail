# Copy this file to .env for local development. Never commit .env.
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
SITE_URL=http://127.0.0.1:8000

# Use SQLite locally. On Oracle Cloud set DATABASE_URL to your PostgreSQL URL.
# Example format: postgres://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=
DATABASE_SSL_REQUIRE=False

# First and only administrator bootstrap. Set these before opening /admin-signup/.
PROVEDMAILS_ADMIN_EMAIL=your-email@example.com
PROVEDMAILS_ADMIN_SIGNUP_KEY=change-this-to-a-long-random-one-time-key

# Set True behind HTTPS only when TLS is terminated by your reverse proxy.
SECURE_SSL_REDIRECT=False
